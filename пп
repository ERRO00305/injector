-- Spin
local spinOn=false
spinBtn.MouseButton1Click:Connect(function()
    spinOn=not spinOn
    if spinOn then
        task.spawn(function()
            while spinOn do
                local ch=pl.Character
                local hrp=ch and ch:FindFirstChild("HumanoidRootPart")
                if hrp then hrp.CFrame=hrp.CFrame*CFrame.Angles(0,math.rad(15),0) end
                task.wait()
            end
        end)
    end
    spinBtn.Text=spinOn and "SPIN: ON" or "SPIN: OFF"
    spinBtn.TextColor3=spinOn and ACC or RD
end)

-- Fling
local flingOn=false
local function doFling()
    if not flingOn then return end
    local ch=pl.Character
    if not ch then return end
    local hrp=ch:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    for _,p in ipairs(P:GetPlayers()) do
        if p~=pl and p.Character then
            local thrp=p.Character:FindFirstChild("HumanoidRootPart")
            if thrp and (thrp.Position-hrp.Position).Magnitude<10 then
                local h=p.Character:FindFirstChildOfClass("Humanoid")
                if h then
                    h:ChangeState(11)
                    thrp.Velocity=Vector3.new(math.random(-200,200),math.random(100,300),math.random(-200,200))
                end
            end
        end
    end
end
flingBtn.MouseButton1Click:Connect(function()
    flingOn=not flingOn
    flingBtn.Text=flingOn and "FLING: ON" or "FLING: OFF"
    flingBtn.TextColor3=flingOn and ACC or RD
    if flingOn then
        task.spawn(function()
            while flingOn do
                doFling()
                task.wait(0.5)
            end
        end)
    end
end)

-- ESP
local es=false
local ks=false
local hls={}
local function clearESP()
    for _,h in pairs(hls) do
        if h and h.Parent then h:Destroy() end
    end
    hls={}
end
local function applyESP()
    clearESP()
    if not es and not ks then return end
    for _,p in ipairs(P:GetPlayers()) do
        if p~=pl and p.Character then
            local ik=false
            if ks then
                local r=p.Character:FindFirstChild("Role") or p:FindFirstChild("Role")
                if r and (r.Value=="Murderer" or r.Value=="Killer") then ik=true end
            end
            if es or ik then
                local h=Instance.new("Highlight")
                h.Adornee=p.Character
                h.Parent=p.Character
                if ik then
                    h.FillColor=Color3.fromRGB(255,0,0)
                    h.OutlineColor=Color3.fromRGB(255,100,100)
                else
                    h.FillColor=ACC
                    h.OutlineColor=PN
                end
                h.FillTransparency=0.4
                h.OutlineTransparency=0
                table.insert(hls,h)
            end
        end
    end
end
espOn.MouseButton1Click:Connect(function()
    es=not es
    espOn.Text=es and "ESP: ON" or "ESP: OFF"
    espOn.TextColor3=es and ACC or RD
    applyESP()
end)
killerOn.MouseButton1Click:Connect(function()
    ks=not ks
    killerOn.Text=ks and "KILLER: ON" or "KILLER: OFF"
    killerOn.TextColor3=ks and ACC or RD
    applyESP()
end)

