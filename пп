local function createSlider(parent,label,minVal,maxVal,defaultVal,order)
    local f=Instance.new("Frame")
    f.Size=UDim2.new(1,0,0,45)
    f.BackgroundTransparency=1
    f.ZIndex=6
    f.Parent=parent
    f.LayoutOrder=order
    local lbl=Instance.new("TextLabel")
    lbl.Size=UDim2.new(0,80,0,16)
    lbl.Position=UDim2.new(0,0,0,0)
    lbl.BackgroundTransparency=1
    lbl.Text=label
    lbl.TextColor3=TX
    lbl.Font=Enum.Font.GothamBold
    lbl.TextSize=11
    lbl.TextXAlignment=Enum.TextXAlignment.Left
    lbl.ZIndex=6
    lbl.Parent=f
    local vd=Instance.new("TextLabel")
    vd.Size=UDim2.new(0,40,0,16)
    vd.Position=UDim2.new(1,-40,0,0)
    vd.BackgroundTransparency=1
    vd.Text=tostring(defaultVal)
    vd.TextColor3=ACC
    vd.Font=Enum.Font.GothamBold
    vd.TextSize=11
    vd.TextXAlignment=Enum.TextXAlignment.Right
    vd.ZIndex=6
    vd.Parent=f
    local track=Instance.new("Frame")
    track.Size=UDim2.new(1,0,0,6)
    track.Position=UDim2.new(0,0,0,22)
    track.BackgroundColor3=BTN
    track.BorderSizePixel=0
    track.ZIndex=6
    track.Parent=f
    local tc=Instance.new("UICorner")
    tc.CornerRadius=UDim.new(1,0)
    tc.Parent=track
    local fill=Instance.new("Frame")
    fill.Size=UDim2.new((defaultVal-minVal)/(maxVal-minVal),0,1,0)
    fill.BackgroundColor3=ACC
    fill.BorderSizePixel=0
    fill.ZIndex=7
    fill.Parent=track
    local fc=Instance.new("UICorner")
    fc.CornerRadius=UDim.new(1,0)
    fc.Parent=fill
    local thumb=Instance.new("Frame")
    thumb.Size=UDim2.new(0,14,0,14)
    thumb.Position=UDim2.new((defaultVal-minVal)/(maxVal-minVal),-7,0.5,-7)
    thumb.BackgroundColor3=PN
    thumb.BorderSizePixel=0
    thumb.ZIndex=8
    thumb.Parent=track
    local thc=Instance.new("UICorner")
    thc.CornerRadius=UDim.new(1,0)
    thc.Parent=thumb
    local ths=Instance.new("UIStroke")
    ths.Color=ACC
    ths.Thickness=2
    ths.Parent=thumb
    local dragging=false
    local function applyStretch(val)
        local ch=pl.Character
        if not ch then return end
        local hum=ch:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        local desc=hum:GetAppliedDescription()
        if desc then
            if label:find("Height") then desc.HeightScale=val end
            if label:find("Width") then desc.WidthScale=val end
            hum:ApplyDescription(desc)
        end
    end
    local function updateSlider(x)
        local relX=x-track.AbsolutePosition.X
        local clamped=math.clamp(relX,0,track.AbsoluteSize.X)
        local alpha=clamped/track.AbsoluteSize.X
        local val=minVal+(maxVal-minVal)*alpha
        val=math.floor(val*10+0.5)/10
        fill.Size=UDim2.new(alpha,0,1,0)
        thumb.Position=UDim2.new(alpha,-7,0.5,-7)
        vd.Text=tostring(val)
        applyStretch(val)
    end
    track.InputBegan:Connect(function(input)
        if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
            dragging=true
            updateSlider(input.Position.X)
        end
    end)
    U.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch) then
            updateSlider(input.Position.X)
        end
    end)
    U.InputEnded:Connect(function(input)
        if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
            dragging=false
        end
    end)
    return f
end

