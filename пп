-- Прогресс загрузки (5 секунд)
task.spawn(function()
    local total=5
    local start=tick()
    local pr=0
    while pr<1 do
        local el=tick()-start
        pr=math.min(el/total,1)
        local e=1-(1-pr)^2
        barFill.Size=UDim2.new(e,0,1,0)
        percentText.Text=math.floor(e*100).."%"
        R.Heartbeat:Wait()
    end
    barFill.Size=UDim2.new(1,0,1,0)
    percentText.Text="100%"
    task.wait(0.3)
    -- Плавное исчезновение
    T:Create(loadBg,TweenInfo.new(0.5),{BackgroundTransparency=1}):Play()
    T:Create(jpTop,TweenInfo.new(0.4),{TextTransparency=1}):Play()
    T:Create(mainText,TweenInfo.new(0.4),{TextTransparency=1}):Play()
    T:Create(subText,TweenInfo.new(0.4),{TextTransparency=1}):Play()
    T:Create(percentText,TweenInfo.new(0.4),{TextTransparency=1}):Play()
    T:Create(barBg,TweenInfo.new(0.4),{BackgroundTransparency=1}):Play()
    T:Create(barFill,TweenInfo.new(0.4),{BackgroundTransparency=1}):Play()
    task.wait(0.5)
