local cache={}
local function getT(an,id,pr) local k=tostring(id) if cache[k] then pcall(function() if cache[k].IsPlaying then cache[k]:Stop(0) end end) return cache[k] end local a=Instance.new("Animation") a.AnimationId="rbxassetid://"..id local ok,tr=pcall(function() return an:LoadAnimation(a) end) if not ok or not tr then return nil end tr.Priority=pr or Enum.AnimationPriority.Action cache[k]=tr return tr end
local function isR15(ch) return ch and ch:FindFirstChild("UpperTorso")~=nil end
local cur=nil local flyTrack=nil
local function parts() local ch=pl.Character if not ch then return end local hm=ch:FindFirstChildOfClass("Humanoid") if not hm then return end local an=hm:FindFirstChildOfClass("Animator") if not an then return end return ch,hm,an,ch:FindFirstChild("Animate") end
local function play(id) if id=="0" or id=="" then return end local ch,_,an=parts() if not an then return end if cur then pcall(function() cur:Stop() end) cur=nil end local tr=getT(an,id,Enum.AnimationPriority.Action) if tr then pcall(function() tr:Play(0.1) end) cur=tr end end
local function bundle(d) local ch,_,_,a=parts() if not a then return end if not isR15(ch) then return end local function s(o,i) if o then pcall(function() o.AnimationId="rbxassetid://"..i end) end end if a.idle then if a.idle.Animation1 then s(a.idle.Animation1,d.idle) end if a.idle.Animation2 then s(a.idle.Animation2,d.idle) end end if a.walk and a.walk.WalkAnim then s(a.walk.WalkAnim,d.walk) end if a.run and a.run.RunAnim then s(a.run.RunAnim,d.run) end if a.jump and a.jump.JumpAnim then s(a.jump.JumpAnim,d.jump) end if a.fall and a.fall.FallAnim then s(a.fall.FallAnim,d.fall) end if a.swim and a.swim.Swim then s(a.swim.Swim,d.swim) end if a.swimidle and a.swimidle.SwimIdle then s(a.swimidle.SwimIdle,d.swimidle) end if a.climb and a.climb.ClimbAnim then s(a.climb.ClimbAnim,d.climb) end a.Disabled=true task.wait(0.05) a.Disabled=false end
